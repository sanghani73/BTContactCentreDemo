# Copy to .env and fill in. Omit any value to fall back to mock mode for that
# subsystem (mock Mongo, mock LLM) — so the demo runs end-to-end with zero
# credentials and you can swap each piece for the real thing one at a time.

# --- MongoDB Atlas --------------------------------------------------------
# SRV URI. When unset, the demo runs with the in-memory mock store.
MONGO_URI=
MONGO_DB=bt_contact_centre

# --- Grove LLM gateway ----------------------------------------------------
# Full endpoint — including /v1/messages. Example:
#   https://ai-gateway.corp.mongodb.com/anthropic/v1/messages
LLM_BASE_URL=
LLM_API_KEY=
# Model name as Grove's /anthropic path expects it (e.g. claude-sonnet-4-5).
LLM_MODEL=claude-sonnet-4-5

# --- Voyage AI ------------------------------------------------------------
# Not configured here. Voyage AI is wired into Atlas at mongot deployment
# time via the Atlas UI (Project Settings → Integrations → Voyage AI).
# The autoEmbed index uses it server-side; no application-side key.

# --- Misc -----------------------------------------------------------------
RECENT_WINDOW_DAYS=7
HOST=0.0.0.0
PORT=8080
