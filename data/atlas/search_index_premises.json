{
  "name": "search_index_premises",
  "type": "search",
  "database": "bt_contact_centre",
  "collectionName": "premises",
  "definition": {
    "mappings": {
      "dynamic": false,
      "fields": {
        "address": {
          "type": "document",
          "fields": {
            "thoroughfareName": [
              {
                "type": "autocomplete",
                "tokenization": "edgeGram",
                "minGrams": 3,
                "maxGrams": 15
              }
            ],
            "postTown": { "type": "string" },
            "postcode": { "type": "string" }
          }
        },
        "uprn": { "type": "token" }
      }
    }
  }
}
